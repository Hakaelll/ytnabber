{
  "name": "ytnabber",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "tauri": "tauri",
    "engines:prepare": "node scripts/prepare-engines.mjs",
    "engines:verify": "node scripts/verify-engines.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "test:engines": "cargo test --manifest-path src-tauri/Cargo.toml real_engines -- --ignored --nocapture --test-threads=1",
    "size:release": "node scripts/measure-release.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
